<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="mobile-web-app-capable" content="yes">

<title>営業日報</title>

<style>
:root{
  --ink:#1c2321;
  --ink-soft:#4a5551;
  --paper:#f1f0ec;
  --paper-raised:#ffffff;
  --line:rgba(28,35,33,0.14);
  --amber:#e39a2d;
  --amber-deep:#b8781c;
  --steel:#2c4a5e;
  --danger:#b33f30;
  --ok:#3d6b4c;
  --radius:14px;
}

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  height:100%;
}

body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:
    -apple-system,
    BlinkMacSystemFont,
    "Hiragino Sans",
    "Hiragino Kaku Gothic ProN",
    system-ui,
    sans-serif;
  display:flex;
  flex-direction:column;
  min-height:100vh;
  padding-top:env(safe-area-inset-top);
  padding-bottom:env(safe-area-inset-bottom);
}

header{
  padding:18px 20px 14px;
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  border-bottom:1px solid var(--line);
}

header h1{
  font-size:19px;
  margin:0;
  font-weight:800;
}

#statusBadge{
  font-size:12px;
  font-weight:700;
  padding:5px 10px;
  border-radius:999px;
  background:var(--paper-raised);
  border:1px solid var(--line);
  color:var(--ink-soft);
}

#statusBadge.active{
  background:var(--amber);
  color:#241a06;
  border-color:var(--amber-deep);
}

main{
  flex:1;
  padding:18px 20px 110px;
  overflow-y:auto;
}

.view{
  display:none;
}

.view.show{
  display:block;
  animation:fadeUp .18s ease;
}

@keyframes fadeUp{
  from{
    opacity:0;
    transform:translateY(6px);
  }
  to{
    opacity:1;
    transform:none;
  }
}

.ticket{
  background:var(--paper-raised);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:16px 18px;
  margin-bottom:18px;
  position:relative;
  box-shadow:0 1px 2px rgba(0,0,0,.04);
}

.ticket::before{
  content:"";
  position:absolute;
  left:0;
  right:0;
  top:0;
  height:4px;
  background:repeating-linear-gradient(
    90deg,
    var(--amber) 0 10px,
    transparent 10px 18px
  );
  border-radius:var(--radius) var(--radius) 0 0;
}

.ticket .label{
  font-size:11px;
  color:var(--ink-soft);
  margin-bottom:2px;
  letter-spacing:.05em;
}

.ticket .value{
  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
  font-size:15px;
  margin-bottom:10px;
  word-break:break-word;
}

.empty-note{
  color:var(--ink-soft);
  font-size:14px;
  line-height:1.7;
  padding:24px 4px;
  text-align:center;
}

h2.section-title{
  font-size:15px;
  font-weight:800;
  margin:0 0 14px;
  color:var(--steel);
}

label{
  display:block;
  font-size:12px;
  font-weight:700;
  color:var(--ink-soft);
  margin:16px 0 6px;
}

label:first-of-type{
  margin-top:0;
}

input[type=text],
input[type=number],
input[type=date],
input[type=time],
textarea{
  width:100%;
  font-size:16px;
  padding:12px 13px;
  border-radius:10px;
  border:1px solid var(--line);
  background:var(--paper-raised);
  color:var(--ink);
  font-family:inherit;
}

textarea{
  min-height:120px;
  resize:vertical;
  line-height:1.5;
}

input:focus,
textarea:focus{
  outline:2px solid var(--steel);
  outline-offset:1px;
}

.btn{
  display:block;
  width:100%;
  text-align:center;
  padding:14px 16px;
  border-radius:10px;
  border:none;
  font-size:15px;
  font-weight:800;
  margin-top:20px;
  cursor:pointer;
}

.btn-primary{
  background:var(--steel);
  color:#fff;
}

.btn-amber{
  background:var(--amber);
  color:#241a06;
}

.btn-ghost{
  background:transparent;
  color:var(--ink-soft);
  border:1px solid var(--line);
  margin-top:10px;
}

.btn-danger{
  background:transparent;
  color:var(--danger);
  border:1px solid var(--danger);
  margin-top:10px;
}

.btn-small{
  width:auto;
  display:inline-block;
  padding:9px 12px;
  font-size:12px;
  margin-top:8px;
}

.log-entry{
  background:var(--paper-raised);
  border:1px solid var(--line);
  border-radius:12px;
  padding:14px;
  margin-bottom:12px;
}

.log-entry-title{
  font-weight:800;
  font-size:15px;
  margin-bottom:8px;
}

.log-entry-row{
  font-size:13px;
  line-height:1.6;
  color:var(--ink-soft);
}

.log-entry-row strong{
  color:var(--ink);
}

.location{
  font-size:11px;
  color:var(--ink-soft);
  margin-top:8px;
  word-break:break-all;
}

pre#logDump{
  background:var(--ink);
  color:#e8e6df;
  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
  font-size:12px;
  padding:14px;
  border-radius:10px;
  white-space:pre-wrap;
  word-break:break-all;
  max-height:40vh;
  overflow-y:auto;
}

nav#tabbar{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  display:flex;
  gap:7px;
  padding:10px 10px calc(10px + env(safe-area-inset-bottom));
  background:var(--paper);
  border-top:1px solid var(--line);
  z-index:20;
}

nav#tabbar button{
  flex:1;
  padding:12px 4px;
  border-radius:10px;
  border:1px solid var(--line);
  background:var(--paper-raised);
  font-size:12px;
  font-weight:800;
  color:var(--ink);
}

nav#tabbar button.primary{
  background:var(--steel);
  color:#fff;
  border-color:var(--steel);
}

nav#tabbar button.warn{
  background:var(--amber);
  color:#241a06;
  border-color:var(--amber-deep);
}

.overlay{
  position:fixed;
  inset:0;
  background:rgba(28,35,33,.5);
  display:none;
  align-items:flex-end;
  justify-content:center;
  z-index:50;
}

.overlay.show{
  display:flex;
}

.sheet{
  background:var(--paper-raised);
  width:100%;
  max-width:480px;
  border-radius:16px 16px 0 0;
  padding:22px 20px calc(22px + env(safe-area-inset-bottom));
  max-height:90vh;
  overflow-y:auto;
}

.sheet p{
  font-size:14px;
  line-height:1.7;
  color:var(--ink-soft);
  margin:4px 0 0;
}

.sheet .value{
  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
  font-weight:700;
  color:var(--ink);
}

.section-separator{
  border:0;
  border-top:1px solid var(--line);
  margin:22px 0;
}

.info-box{
  background:rgba(44,74,94,.07);
  border-radius:10px;
  padding:12px;
  margin-bottom:14px;
  font-size:12px;
  line-height:1.6;
}

.success-box{
  background:rgba(61,107,76,.10);
  border-radius:10px;
  padding:12px;
  margin-bottom:14px;
  font-size:12px;
}

.vehicle-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.vehicle-grid .btn{
  margin-top:4px;
}

@media(max-width:380px){
  nav#tabbar button{
    font-size:11px;
    padding-left:2px;
    padding-right:2px;
  }
}
</style>
</head>

<body>

<header>
  <h1>営業日報</h1>
  <span id="statusBadge">待機中</span>
</header>

<main>

<!-- =========================
     HOME
========================= -->
<section id="view-home" class="view show">

  <div id="homeTicket"></div>

</section>


<!-- =========================
     START
========================= -->
<section id="view-start" class="view">

  <h2 class="section-title">訪問開始</h2>

  <label for="destInput">訪問先名称</label>
  <input
    type="text"
    id="destInput"
    placeholder="例：株式会社ABC"
    autocomplete="off"
  >

  <label for="contactInput">打合せ者名</label>
  <input
    type="text"
    id="contactInput"
    placeholder="例：山田太郎"
    autocomplete="off"
  >

  <div class="info-box">
    「開始を記録」を押すと、現在日時と位置情報を取得します。
    位置情報を取得できない場合でも訪問記録は保存されます。
  </div>

  <button
    class="btn btn-primary"
    onclick="submitStart()"
  >
    開始を記録
  </button>

  <button
    class="btn btn-ghost"
    onclick="goHome()"
  >
    キャンセル
  </button>

</section>


<!-- =========================
     END
========================= -->
<section id="view-end" class="view">

  <h2 class="section-title">訪問終了</h2>

  <div id="endTicket"></div>

  <label for="contentInput">打合せ内容</label>

  <textarea
    id="contentInput"
    placeholder="例：使用状況を確認。来月の使用量を確認。"
  ></textarea>

  <div class="info-box">
    「終了を記録」を押すと、終了時刻と現在位置を取得します。
  </div>

  <button
    class="btn btn-amber"
    onclick="submitEnd()"
  >
    終了を記録
  </button>

  <button
    class="btn btn-ghost"
    onclick="goHome()"
  >
    キャンセル
  </button>

</section>


<!-- =========================
     LOG
========================= -->
<section id="view-log" class="view">

  <h2 class="section-title">営業日報ログ</h2>

  <div id="logList"></div>

  <div
    id="logEmpty"
    class="empty-note"
  >
    まだ記録がありません。
  </div>

  <hr class="section-separator">

  <h2 class="section-title">CSVデータ</h2>

  <pre id="logDump">（まだ記録がありません）</pre>

  <button
    class="btn btn-primary"
    onclick="sendMail()"
  >
    メールで送信
  </button>

  <button
    class="btn btn-ghost"
    onclick="copyLog()"
  >
    CSVをコピー
  </button>

  <button
    class="btn btn-danger"
    onclick="clearLogConfirm()"
  >
    ログを消去
  </button>

</section>


<!-- =========================
     VEHICLE
========================= -->
<section id="view-vehicle" class="view">

  <h2 class="section-title">車両情報</h2>

  <div id="vehicleView"></div>

  <button
    class="btn btn-amber"
    onclick="openVehicleEdit()"
  >
    車両情報を編集
  </button>

</section>


<!-- =========================
     VEHICLE EDIT
========================= -->
<section id="view-vehicle-edit" class="view">

  <h2 class="section-title">車両情報の編集</h2>

  <label for="vehicleStart">出発時走行距離 (km)</label>
  <input
    type="number"
    id="vehicleStart"
    inputmode="numeric"
  >

  <label for="vehicleEnd">帰社時走行距離 (km)</label>
  <input
    type="number"
    id="vehicleEnd"
    inputmode="numeric"
  >

  <label for="fuelQuantity">給油数量 (L)</label>
  <input
    type="number"
    id="fuelQuantity"
    inputmode="decimal"
    step="0.1"
  >

  <label for="fuelTime">給油時刻</label>
  <input
    type="time"
    id="fuelTime"
  >

  <div class="info-box">
    給油位置を再取得する場合は下のボタンを使用してください。
  </div>

  <button
    class="btn btn-ghost"
    onclick="getFuelLocation()"
  >
    給油位置を取得
  </button>

  <div id="fuelLocationStatus"></div>

  <button
    class="btn btn-primary"
    onclick="saveVehicleEdit()"
  >
    車両情報を保存
  </button>

  <button
    class="btn btn-ghost"
    onclick="openVehicle()"
  >
    キャンセル
  </button>

</section>


<!-- =========================
     REPORT EDIT
========================= -->
<section id="view-edit" class="view">

  <h2 class="section-title">営業日報の編集</h2>

  <input
    type="hidden"
    id="editIndex"
  >

  <label for="editDate">日付</label>
  <input
    type="text"
    id="editDate"
  >

  <label for="editStart">開始時間</label>
  <input
    type="text"
    id="editStart"
  >

  <label for="editEnd">終了時間</label>
  <input
    type="text"
    id="editEnd"
  >

  <label for="editDest">訪問先名称</label>
  <input
    type="text"
    id="editDest"
  >

  <label for="editContact">打合せ者名</label>
  <input
    type="text"
    id="editContact"
  >

  <label for="editContent">打合せ内容</label>
  <textarea
    id="editContent"
  ></textarea>

  <button
    class="btn btn-primary"
    onclick="saveLogEntryEdit()"
  >
    保存
  </button>

  <button
    class="btn btn-danger"
    onclick="deleteLogEntry()"
  >
    この記録を削除
  </button>

  <button
    class="btn btn-ghost"
    onclick="openLog()"
  >
    キャンセル
  </button>

</section>

</main>


<!-- =========================
     TAB BAR
========================= -->
<nav id="tabbar">

  <button onclick="goHome()">
    ホーム
  </button>

  <button
    class="warn"
    onclick="openStart()"
  >
    訪問開始
  </button>

  <button
    class="primary"
    onclick="openEnd()"
  >
    訪問終了
  </button>

  <button onclick="openLog()">
    ログ
  </button>

</nav>


<!-- =========================
     START MILEAGE
========================= -->
<div
  class="overlay"
  id="mileageStartOverlay"
>

  <div class="sheet">

    <h2 class="section-title">
      本日の出発時走行距離
    </h2>

    <p>
      本日最初の訪問を始める前に、
      車の走行距離(km)を入力してください。
    </p>

    <label for="mileageStartInput">
      走行距離 (km)
    </label>

    <input
      type="number"
      id="mileageStartInput"
      inputmode="numeric"
      placeholder="例：58230"
    >

    <button
      class="btn btn-amber"
      onclick="submitMileageStart()"
    >
      記録して次へ
    </button>

    <button
      class="btn btn-ghost"
      onclick="closeMileageStart()"
    >
      キャンセル
    </button>

  </div>
</div>


<!-- =========================
     END MILEAGE
========================= -->
<div
  class="overlay"
  id="mileageEndOverlay"
>

  <div class="sheet">

    <h2 class="section-title">
      帰社時走行距離
    </h2>

    <p>
      本日の業務終了時の走行距離(km)を入力してください。
    </p>

    <label for="mileageEndInput">
      走行距離 (km)
    </label>

    <input
      type="number"
      id="mileageEndInput"
      inputmode="numeric"
      placeholder="例：58390"
    >

    <button
      class="btn btn-primary"
      onclick="submitMileageEnd()"
    >
      記録する
    </button>

    <button
      class="btn btn-ghost"
      onclick="closeMileageEnd()"
    >
      キャンセル
    </button>

  </div>
</div>


<!-- =========================
     WARNING
========================= -->
<div
  class="overlay"
  id="warnOverlay"
>

  <div class="sheet">

    <h2 class="section-title">
      前回の訪問が終了していません
    </h2>

    <p>
      訪問先：
      <span
        class="value"
        id="warnDest"
      ></span>
    </p>

    <p>
      開始：
      <span
        class="value"
        id="warnTime"
      ></span>
    </p>

    <p style="margin-top:12px;">
      新しい訪問を開始しますか？
      未終了データは上書きされます。
    </p>

    <button
      class="btn btn-amber"
      onclick="proceedNewVisit()"
    >
      新しい訪問を開始
    </button>

    <button
      class="btn btn-ghost"
      onclick="closeWarn()"
    >
      キャンセル
    </button>

  </div>
</div>


<script>

/* =========================================================
   保存キー
========================================================= */

const LOG_KEY = "eigyo_log_entries";
const WORK_KEY = "eigyo_working";
const VEHICLE_KEY = "eigyo_vehicle";


/* =========================================================
   状態
========================================================= */

let mileageStartContinue = false;
let editingWorkingMode = false;
let currentLocation = null;


/* =========================================================
   基本関数
========================================================= */

function pad(n){
  return String(n).padStart(2,"0");
}


function nowParts(){

  const d = new Date();

  return {
    date:
      d.getFullYear() +
      "/" +
      pad(d.getMonth()+1) +
      "/" +
      pad(d.getDate()),

    time:
      pad(d.getHours()) +
      ":" +
      pad(d.getMinutes())
  };
}


function todayStr(){
  return nowParts().date;
}


function sanitize(s){

  return String(s || "")
    .replace(/,/g,"，")
    .replace(/\r/g,"")
    .replace(/\n/g," ")
    .replace(/\t/g," ")
    .trim();

}


/* =========================================================
   営業日報保存
========================================================= */

function loadLog(){

  try{

    const raw =
      localStorage.getItem(LOG_KEY);

    if(!raw){
      return [];
    }

    const data = JSON.parse(raw);

    return Array.isArray(data)
      ? data
      : [];

  }catch(e){

    console.error(e);

    return [];

  }

}


function saveLog(arr){

  localStorage.setItem(
    LOG_KEY,
    JSON.stringify(arr)
  );

}


/* =========================================================
   作業中訪問
========================================================= */

function loadWorking(){

  try{

    const raw =
      localStorage.getItem(WORK_KEY);

    return raw
      ? JSON.parse(raw)
      : null;

  }catch(e){

    return null;

  }

}


function saveWorking(obj){

  localStorage.setItem(
    WORK_KEY,
    JSON.stringify(obj)
  );

}


function clearWorking(){

  localStorage.removeItem(
    WORK_KEY
  );

}


/* =========================================================
   車両情報
========================================================= */

function loadVehicle(){

  try{

    const raw =
      localStorage.getItem(VEHICLE_KEY);

    return raw
      ? JSON.parse(raw)
      : null;

  }catch(e){

    return null;

  }

}


function saveVehicle(obj){

  localStorage.setItem(
    VEHICLE_KEY,
    JSON.stringify(obj)
  );

}


/* =========================================================
   位置情報
========================================================= */

function getLocation(callback){

  if(
    !navigator.geolocation
  ){

    callback(null);

    return;
  }


  navigator.geolocation.getCurrentPosition(

    function(position){

      const loc = {

        latitude:
          position.coords.latitude,

        longitude:
          position.coords.longitude,

        accuracy:
          position.coords.accuracy,

        time:
          new Date().toISOString()

      };

      callback(loc);

    },

    function(error){

      console.log(
        "位置情報取得失敗:",
        error
      );

      callback(null);

    },

    {
      enableHighAccuracy:true,
      timeout:10000,
      maximumAge:0
    }

  );

}


/* =========================================================
   位置情報表示
========================================================= */

function locationText(loc){

  if(!loc){

    return "取得できませんでした";

  }

  return (
    "緯度 " +
    loc.latitude.toFixed(6) +
    " / 経度 " +
    loc.longitude.toFixed(6) +
    " / 精度 " +
    Math.round(loc.accuracy) +
    "m"
  );

}


/* =========================================================
   画面切替
========================================================= */

function setView(id){

  document
    .querySelectorAll(".view")
    .forEach(function(v){

      v.classList.remove("show");

    });


  const el =
    document.getElementById(id);

  if(el){

    el.classList.add("show");

  }

}


/* =========================================================
   ステータス
========================================================= */

function refreshBadge(){

  const w =
    loadWorking();

  const badge =
    document.getElementById(
      "statusBadge"
    );


  if(w){

    badge.textContent =
      "訪問中";

    badge.classList.add(
      "active"
    );

  }else{

    badge.textContent =
      "待機中";

    badge.classList.remove(
      "active"
    );

  }

}


/* =========================================================
   ホーム表示
========================================================= */

function renderHome(){

  const el =
    document.getElementById(
      "homeTicket"
    );

  let html = "";


  const v =
    loadVehicle();


  if(v && v.date === todayStr()){

    html += `
      <div class="ticket">

        <div class="label">
          車両情報
        </div>

        <div class="label">
          出発時走行距離
        </div>

        <div class="value">
          ${
            v.startMileage != null
            ? v.startMileage + " km"
            : "未入力"
          }
        </div>

        <div class="label">
          給油数量
        </div>

        <div class="value">
          ${
            v.fuelQuantity != null
            ? v.fuelQuantity + " L"
            : "未入力"
          }
        </div>

        <div class="label">
          帰社時走行距離
        </div>

