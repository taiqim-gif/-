/* =========================================================
   CSV
========================================================= */

function csvLocation(loc){

  if(!loc){
    return "";
  }


  return (
    loc.latitude.toFixed(6) +
    "," +
    loc.longitude.toFixed(6)
  );

}


function reportCsv(){

  const logs =
    loadLog();


  let csv =
    "日付,開始時間,終了時間,訪問先名称,打合せ者名,内容,開始緯度,開始経度,終了緯度,終了経度\n";


  logs.forEach(
    function(item){

      csv +=
        [
          sanitize(item.date),
          sanitize(item.startTime),
          sanitize(item.endTime),
          sanitize(item.dest),
          sanitize(item.contact),
          sanitize(item.content),
          item.startLocation
            ? item.startLocation.latitude.toFixed(6)
            : "",
          item.startLocation
            ? item.startLocation.longitude.toFixed(6)
            : "",
          item.endLocation
            ? item.endLocation.latitude.toFixed(6)
            : "",
          item.endLocation
            ? item.endLocation.longitude.toFixed(6)
            : ""

        ].join(",") +
        "\n";

    }
  );


  return csv;

}


function vehicleCsv(){

  const v =
    loadVehicle();


  if(
    !v ||
    v.date !== todayStr()
  ){

    return "";

  }


  let csv =
    "\n車両情報\n";


  csv +=
    "日付,出発時走行距離,給油数量,給油時刻,給油緯度,給油経度,帰社時走行距離\n";


  csv +=
    [
      sanitize(v.date),

      v.startMileage != null
        ? v.startMileage
        : "",

      v.fuelQuantity != null
        ? v.fuelQuantity
        : "",

      sanitize(v.fuelTime || ""),

      v.fuelLocation
        ? v.fuelLocation.latitude.toFixed(6)
        : "",

      v.fuelLocation
        ? v.fuelLocation.longitude.toFixed(6)
        : "",

      v.endMileage != null
        ? v.endMileage
        : ""

    ].join(",");


  return csv;

}


function fullReportText(){

  return (
    reportCsv() +
    vehicleCsv()
  );

}


