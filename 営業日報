    vehicle !== null;


  if(!hasData){

    alert(
      "消去するデータがありません。"
    );

    return;

  }


  if(
    !confirm(
      "営業日報と車両情報をすべて消去します。\n\nPC側への取り込みが完了していることを確認してください。\n\n本当に消去しますか？"
    )
  ){

    return;

  }


  localStorage.removeItem(
    LOG_KEY
  );


  localStorage.removeItem(
    VEHICLE_KEY
  );


  openLog();

}


/* =========================================================
   初期化
========================================================= */

function init(){

  refreshBadge();

  renderHome();

}


init();

</script>

